# server
PORT=3000
# base-sepolia (testnet) or base (mainnet)
NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org
# wallet that receives x402 research payments (0x...)
PAY_TO_ADDRESS=
# price per research report, in USD
PRICE_PER_REPORT_USDC=0.05
# B20 token the treasury sweeps profits into (AAPLc, NVDAc, TSLAc, ...)
TREASURY_TOKEN=AAPLc
# USDC kept back before each sweep
SWEEP_RESERVE_USDC=0.5
# price data: mock (fixed example values) or chainlink (live Base mainnet feeds)
PRICE_SOURCE=mock
# sweep executor: mock (demo swaps) or uniswap (real Base Sepolia swaps)
SWAP_EXECUTOR=mock
# Uniswap Trading API key (free, from the Uniswap docs portal) — needed for SWAP_EXECUTOR=uniswap
UNISWAP_API_KEY=
# Sepolia test-wallet private key (0x...) — needed for SWAP_EXECUTOR=uniswap and for deploying mock tokens.
# Never commit this file. Never paste the key in chat.
TEST_PRIVATE_KEY=
# USDC token used for sweeps (default: Circle faucet USDC on Base Sepolia)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Chainlink feed addresses per symbol, when wiring live prices (FEED_AAPLC, FEED_NVDAC, ...)
# (The 10 official feeds are already in src/feeds.ts — no env needed.)
# FEED_AAPLC=
